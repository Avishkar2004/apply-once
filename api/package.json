{
  "name": "@autofill/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zero-knowledge sync service — stores opaque bytes and hands them back.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute autofill --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute autofill --remote --file=./schema.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@autofill/core": "*",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.1",
    "@cloudflare/workers-types": "^5.20260812.1",
    "wrangler": "^4.121.0"
  }
}
